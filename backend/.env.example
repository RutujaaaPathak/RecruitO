# RecruitO backend environment configuration
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# --- Database ---
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruito

# --- Email / OTP (Gmail SMTP) ---
# Candidate signup requires a 6-digit email OTP by default, so SMTP must be
# configured or candidate signups will fail with a clear error.
# For Gmail, generate an App Password (https://myaccount.google.com/apppasswords)
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Candidate signup email OTP verification (SECURE DEFAULT: required).
# Leave unset or set to false in production. Set to true ONLY for local
# development/testing without an SMTP service (skips sending and checking the
# OTP for candidate signups).
# BYPASS_EMAIL_OTP=false

# --- Admin seed account (used by app/seed_admin.py) ---
ADMIN_EMAIL=admin@recruito.com
ADMIN_PASSWORD=change-me-strong-password

# --- Security ---
# JWT signing secret (REQUIRED). The backend refuses to start if SECRET_KEY is
# missing, shorter than 32 characters, or one of the example placeholders.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
# JWT access token lifetime in minutes (default 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of origins allowed to call the backend.
# Defaults to the local Vite dev server when unset (http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# --- AI Career Recommendations (LLM) ---
# REQUIRED to enable AI-generated career recommendations.
#
# This key is a BACKEND-ONLY secret. It must only ever live in this .env file
# (which is git-ignored). Never add it to frontend code, never send it to the
# browser, and never expose it through any API response. The backend calls the
# LLM provider server-side and returns only the validated recommendation plan.
#
# Any OpenAI-compatible /chat/completions endpoint is supported (OpenAI, Azure
# OpenAI, local servers such as Ollama, etc.).
#   - OpenAI:        LLM_BASE_URL=https://api.openai.com/v1
#   - Azure OpenAI:  LLM_BASE_URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>
#   - OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1
#
# When LLM_API_KEY is unset the recommendations endpoint degrades gracefully
# and returns rule-based recommendations (generated_by="fallback").
LLM_API_KEY=sk-your-backend-only-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Request timeout for the LLM call, in seconds (default 60).
LLM_TIMEOUT=60

# --- AI Mock Interview ---
# Maximum number of questions in a mock interview session (default 8, 1-30).
MOCK_INTERVIEW_MAX_QUESTIONS=8

# --- AI MCQ Assessment ---
# Number of questions in an MCQ assessment (default 20, 5-50).
MCQ_QUESTION_COUNT=20
# Backend-enforced time limit per assessment, in minutes (default 20, 5-120).
# Results are auto-computed when the deadline passes, even without a submit.
MCQ_TIME_LIMIT_MINUTES=20
# Percentage required to pass an assessment (default 60, 1-100).
MCQ_PASS_PERCENTAGE=60

# --- Coding Test ---
# Number of programming problems per coding test (default 5, 1-20).
CODING_TEST_PROBLEM_COUNT=5
# Percentage required to pass a coding test (default 60, 1-100).
CODING_TEST_PASS_PERCENTAGE=60
# Per-test-case execution time limit in seconds (default 5, 1-30).
CODING_TEST_TIME_LIMIT_SECONDS=5
# Maximum code length in characters accepted from candidates (default 64 KB).
CODING_TEST_MAX_CODE_LENGTH=65536

# --- Aptitude Test ---
# Number of questions in an aptitude test (default 20, 5-50).
APTITUDE_QUESTION_COUNT=20
# Backend-enforced time limit per test, in minutes (default 20, 5-120).
# Results are auto-computed when the deadline passes, even without a submit.
APTITUDE_TIME_LIMIT_MINUTES=20
# Percentage required to pass an aptitude test (default 60, 1-100).
APTITUDE_PASS_PERCENTAGE=60

# --- Rate Limiting (Auth) ---
# In-memory sliding-window rate limiting on the /send-otp, /resend-otp and
# /login endpoints. Prevents OTP spam and login brute force. State lives in
# process memory only (never the DB) and resets on restart.
#
# Rate limiting is ON by default. Set RATE_LIMIT_ENABLED=false ONLY for local
# development/testing; leave it unset/true in production.
RATE_LIMIT_ENABLED=true
# Max failed login attempts per IP + email before rejection (default 5).
LOGIN_MAX_ATTEMPTS=5
# Window (seconds) for login attempts (default 300 = 5 min).
LOGIN_WINDOW_SECONDS=300
# Max send/resend OTP requests per IP + email per window (default 3).
OTP_MAX_REQUESTS=3
# Window (seconds) for OTP requests (default 60).
OTP_WINDOW_SECONDS=60
